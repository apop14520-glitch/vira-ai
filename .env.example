# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database: SQLite is the only enabled development backend.
# Keep the URL abstract so it can later be replaced with PostgreSQL.
DATABASE_URL=sqlite:///./database/dev.db

# Future provider selection only. No provider client is implemented yet.
AI_PROVIDER=none

# Frontend: public base URL for the local API health indicator.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Secrets must be supplied through the environment or a secret manager.
# Never place real values in source control.
# Foursquare: optional local-only provider for VIRA Business place search.
# The UI can set a runtime-only key; this variable is safer for repeatable local starts.
# FOURSQUARE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
