# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication boundary.
# Development defaults to a loopback-only local principal. Any other
# environment must configure all three values below with a secret manager.
# API_ACCESS_TOKEN=
# ADMIN_ACCESS_TOKEN=
# AUTH_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
# ALLOW_DEVELOPMENT_AUTH_BYPASS=true

# Administrative web session. The initial password is read once when the
# local credential is first created; replace it immediately in your .env.
# The canonical names below are the recommended ones. The backend still accepts
# these older compatibility names: SENHA_INICIAL_DO_ADMINISTRADOR,
# NOME_DE_USUÁRIO_DO_ADMINISTRADOR, AMBIENTE and ORIGENS_CORS.
ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=
# Alternative for first access through /login: set only in the API .env.
# Leave ADMIN_INITIAL_PASSWORD unset when using the setup form.
# ADMIN_SETUP_TOKEN=<unique random activation code>
ADMIN_SESSION_COOKIE_NAME=vira_admin_session
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOGIN_RATE_LIMIT=5
ADMIN_LOGIN_RATE_WINDOW_SECONDS=300

# Provider abuse protection.
FOURSQUARE_RATE_LIMIT=30
FOURSQUARE_RATE_LIMIT_WINDOW_SECONDS=60

# Database: SQLite for local development. Production uses PostgreSQL, e.g.
# postgresql://vira_api:<password>@127.0.0.1:5432/vira_api
DATABASE_URL=sqlite:///./database/dev.db

# Future provider selection only. No provider client is implemented yet.
AI_PROVIDER=none

# Frontend proxy: server-only destination for the local API.
API_INTERNAL_URL=http://127.0.0.1:8000
# Cloudflare Worker production value: https://137-131-255-128.nip.io
WEB_ORIGIN=http://127.0.0.1:3000

# Secrets must be supplied through the environment or a secret manager.
# Never place real values in source control.
# Foursquare: optional local-only provider for VIRA Business place search.
# The UI can set a runtime-only key; this variable is safer for repeatable local starts.
# FOURSQUARE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
