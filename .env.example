# Runtime
ENVIRONMENT=development
# Only enable this for the local launcher bound to loopback. Hosted services
# remain protected even if ENVIRONMENT is accidentally left as development.
ALLOW_INSECURE_LOCAL_API=true
LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database: SQLite is the only enabled development backend.
# Keep the URL abstract so it can later be replaced with PostgreSQL.
DATABASE_URL=sqlite:///./database/dev.db

# Future provider selection only. No provider client is implemented yet.
AI_PROVIDER=none

# Frontend local API URL. It is a public endpoint address, never a secret.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Optional server-side target for the health route when the API is private.
INTERNAL_API_BASE_URL=http://127.0.0.1:8000
# API_ACCESS_TOKEN=generate-a-long-random-value-for-hosted-environments

# VIRA.AI admin access (hosted web service only). Generate a password hash
# with the documented command; never put the clear-text password in source.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=pbkdf2_sha256$...
# AUTH_SECRET=generate-a-random-value-at-least-32-characters-long

# Secrets must be supplied through the environment or a secret manager.
# Never place real values in source control.
# Foursquare: optional local-only provider for VIRA Business place search.
# The UI can set a runtime-only key; this variable is safer for repeatable local starts.
# FOURSQUARE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
